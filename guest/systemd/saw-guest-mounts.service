[Unit]
Description=Read-only SAW virtiofs mounts
After=cloud-final.service
ConditionPathExists=/etc/saw/guest.json

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/saw/guest
ExecStart=/usr/bin/python3 -m saw_guest.mounts
# Mounts must be in the host namespace, not a private ExecStartPre namespace.
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_FOWNER
LimitCORE=0

[Install]
WantedBy=cloud-init.target
